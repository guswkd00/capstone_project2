# Local development configuration.
# Copy this file to .env and enter your own credentials.
# Never commit .env or real secrets.

DATABASE_TARGET=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=
DB_NAME=shopeefood_db

# TiDB: used only when DATABASE_TARGET=tidb.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=shopeefood_db

# Local server settings.
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0
COOKIE_SECURE=0

# Optional email configuration.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=ShopeeFood Delivery DSS
# APP_PUBLIC_URL=https://shopee-food.onrender.com

# Render overrides:
# HOST=0.0.0.0
# TRUST_PROXY=1
# COOKIE_SECURE=1
# DATABASE_TARGET=tidb
# APP_PUBLIC_URL=https://your-service.onrender.com
